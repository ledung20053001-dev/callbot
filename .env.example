# Application
APP_NAME=ai-clinic-callbot
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO
APP_DEBUG=false

# Call policy
DEFAULT_LOCALE=vi-VN
DEFAULT_CALL_MODE=text
DEFAULT_MAX_TURNS=12
MAX_SILENCE_TURNS=3
MAX_UNDERSTANDING_FAILURES=2
API_RESPONSE_DEADLINE_SECONDS=8

# Clinic Mock: the only source of appointment truth
CLINIC_API_BASE_URL=http://localhost:8080
CLINIC_API_TIMEOUT_SECONDS=5
CLINIC_API_MAX_RETRIES=2

# Session storage. Use memory locally; Redis can be added for deployment.
SESSION_BACKEND=memory
SESSION_TTL_SECONDS=3600
REDIS_URL=redis://localhost:6379/0

# Optional LLM provider
LLM_PROVIDER=disabled
LLM_MODEL=
LLM_TIMEOUT_SECONDS=4
LLM_MAX_TOKENS=256
OPENAI_API_KEY=

# Optional speech providers
STT_PROVIDER=disabled
STT_API_KEY=
TTS_PROVIDER=disabled
TTS_API_KEY=
AUDIO_STORAGE_DIR=audio/output
AUDIO_BASE_URL=http://localhost:8000/audio

# Optional telephony provider
TELEPHONY_PROVIDER=disabled
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
STRINGEE_API_KEY=
STRINGEE_API_SECRET=

# Observability and privacy
LOG_FORMAT=json
ENABLE_METRICS=true
METRICS_PATH=/metrics
REDACT_SENSITIVE_DATA=true
TRACE_REPOSITORY_PATH=.ai-log/traces.jsonl
